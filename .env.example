# Lab topology and service endpoints — copy to .env and fill in real values.
# NEVER commit .env (gitignored). Upload to Vault via: make upload-lab-config
#
# Required for make check-env / bootstrap (existing)
OCP_CENTRAL_SERVER=
OCP_CENTRAL_USERNAME=
OCP_CENTRAL_PASSWORD=
OCP_SERVICES_SERVER=
OCP_SERVICES_USERNAME=
OCP_SERVICES_PASSWORD=
OCI_REGISTRY=quay.io/gauravshankar
OCI_REGISTRY_TOKEN=
OCI_ROBOT_USERNAME=
OCI_ROBOT_PASSWORD=
GITHUB_URL=
GITHUB_TOKEN=
IMAGE_REGISTRY=
IMAGE_REGISTRY_USERNAME=
IMAGE_REGISTRY_PASSWORD=
OSO_CLOUDS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# Lab topology primitives (compose FQDNs; do not commit real lab domains)
LAB_DOMAIN=
BASE_DOMAIN=
CENTRAL_CLUSTER_NAME=
SERVICES_CLUSTER_NAME=
APPS_SUBDOMAIN=apps
OCI_REPOSITORY_BASE=

# Derived / explicit service endpoints (set explicitly to avoid guesswork)
CENTRAL_APPS_DOMAIN=
SERVICES_APPS_DOMAIN=
OCI_HOST=quay.io/gauravshankar
DNS_FORWARDER_ZONE=
DNS_FORWARDER_IPS=

VAULT_CENTRAL_URL=
VAULT_SERVICES_URL=
RHBK_CENTRAL_URL=
RHBK_SERVICES_URL=
# SCM — prefer in-cluster Gitea for disconnected (override only if intentionally using an external mirror)
# GITEA_URL is the public/route URL; Jobs should use http://gitea-http.gitea.svc:3000/... for in-cluster pulls
GITEA_URL=
# Optional overrides (defaults already point at Gitea eda-lab)
# EDA_REPO_URL=http://gitea-http.gitea.svc:3000/hybrid-sovereign/eda-lab.git
# RULEBOOK_REPO_URL=http://gitea-http.gitea.svc:3000/hybrid-sovereign/eda-lab.git

AAP_CENTRAL_GATEWAY_URL=
AAP_CENTRAL_CONTROLLER_URL=
AAP_SERVICES_GATEWAY_URL=
AAP_SERVICES_CONTROLLER_URL=
QUAY_CENTRAL_URL=
QUAY_SERVICES_URL=
ACS_CENTRAL_URL=
S3_ENDPOINT=
VMWARE_VCENTER_URL=
CLUSTER_BUILDS_REPO_URL=

# Optional bootstrap secrets (session-only; prefer Vault)
GITEA_ADMIN_PASSWORD=
VMWARE_HOST=
VMWARE_USERNAME=
VMWARE_PASSWORD=
VMWARE_THUMBPRINT=
VAULT_TOKEN=
KAFKA_BOOTSTRAP_HOST=
