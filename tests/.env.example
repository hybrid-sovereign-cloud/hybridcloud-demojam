# =============================================================================
# tests/.env.example  —  credential surface for the HybridSovereign test suite
# =============================================================================
# Copy to tests/.env and fill in. tests/.env is gitignored and MUST NEVER be
# committed. No value in this file is a real credential.
#
#   cp tests/.env.example tests/.env && ${EDITOR:-vi} tests/.env
#
# Most users only need SECTION 1. The platform's own admin credentials for
# Keycloak / AAP / Quay / Vault are already stored as Secrets on the hub
# cluster, and the suite reads them from there by default. Only set SECTION 3
# if you want to override that (e.g. testing against an external instance).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# SECTION 1 — REQUIRED: hub ("central") OpenShift cluster
# -----------------------------------------------------------------------------
# The cluster that runs the HybridSovereign operators and holds the CRDs.
OCP_CENTRAL_SERVER=https://api.your-hub.example.com:6443
OCP_CENTRAL_USERNAME=kubeadmin
OCP_CENTRAL_PASSWORD=

# Skip TLS verification against the hub API (lab clusters use self-signed certs).
OCP_CENTRAL_VALIDATE_CERTS=false


# -----------------------------------------------------------------------------
# SECTION 2 — OPTIONAL: OpenStack (RHOSO) site
# -----------------------------------------------------------------------------
# Needed only for test-eevee-openstack-network.yaml and
# test-snorlax-openstack-vm.yaml. Leave OSO_CLOUDS empty to skip those suites.
#
# Path to a clouds.yaml. NEVER copy clouds.yaml into this repo — it is
# gitignored for a reason. Point at a path outside the working tree.
OSO_CLOUDS=/home/youruser/.config/openstack/clouds.yaml
OS_CLOUD=openstack

# Flavor / image used for the throwaway Snorlax connectivity VM. These must
# already exist in the OpenStack project; the suite does not upload images.
OSO_TEST_IMAGE=cirros
OSO_TEST_FLAVOR=m1.tiny
OSO_EXTERNAL_NETWORK=ext-net


# -----------------------------------------------------------------------------
# SECTION 3 — OPTIONAL overrides: tool endpoints and admin credentials
# -----------------------------------------------------------------------------
# Leave ALL of these empty to have the suite resolve them from the hub cluster
# (the default, and the recommended path). Set a URL *and* its credentials
# together if you override — a half-set override is rejected at preflight.

# Keycloak / RHBK — verifies that Rbac CRs really created the groups.
RHBK_URL=
RHBK_USERNAME=
RHBK_PASSWORD=
RHBK_REALM=sso

# Ansible Automation Platform — verifies that AAPOrg CRs really created the org.
AAP_URL=
AAP_USERNAME=
AAP_PASSWORD=

# Quay — verifies that QuayOrg CRs really created the organization.
QUAY_URL=
QUAY_USERNAME=
QUAY_PASSWORD=
# A Quay OAuth token with at least org:admin scope. Optional: only needed if
# the Quay API rejects basic auth for organization reads.
QUAY_TOKEN=

# Vault — verifies that Vault / VaultKV CRs really created the mount + policies.
VAULT_ADDR=
VAULT_TOKEN=


# -----------------------------------------------------------------------------
# SECTION 4 — test-run behaviour (not credentials)
# -----------------------------------------------------------------------------
# Seconds to wait for a CR to reach Ready before failing the test.
HS_READY_TIMEOUT=900
# Seconds to wait for a CR to disappear after deletion.
HS_DESTROY_TIMEOUT=600
# Set to "true" to leave resources behind when a test fails, for debugging.
HS_KEEP_ON_FAILURE=false
