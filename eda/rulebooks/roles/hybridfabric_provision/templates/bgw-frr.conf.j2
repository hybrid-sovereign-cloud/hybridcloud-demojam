frr defaults traditional
hostname {{ bgw_name }}
log syslog informational
service integrated-vtysh-config
!
{% if bgw_rt_filter_enabled | bool %}
! Tenant isolation (design/fabric.md §8.5.4): every tenant VRF shares this route
! reflector, so only EVPN routes whose route-target was allocated from this
! fabric's numbering ledger (fabric-numbering-{{ bgw_fabric_name }}, RT = ASN:VNI)
! are accepted from spokes and therefore reflected. Anything else is dropped on
! input. Applied to the l2vpn evpn address family only. Re-rendered by EDA when
! a HybridNetwork gets a new VNI.
{% for rt in bgw_allowed_rts %}
bgp extcommunity-list standard FABRIC-RT permit rt {{ rt }}
{% endfor %}
!
{% endif %}
{% if bgw_rt_policy_per_site | bool %}
! Per-site RT policy (plan §3.2.5, decision 6): one peer-group per site
! (listen ranges below). A site may only announce, and only receives, the RTs of
! the HybridNetworks placed on it (NetworkPlacements), intersected with the
! ledger allow-list above. Re-rendered by EDA when placements change.
{% for g in bgw_peer_groups %}
{% for rt in g.rts %}
bgp extcommunity-list standard {{ g.name }}-RT permit rt {{ rt }}
{% endfor %}
{% if g.rts | length > 0 %}
route-map {{ g.name }}-EVPN-IN permit 10
 match extcommunity {{ g.name }}-RT
exit
route-map {{ g.name }}-EVPN-OUT permit 10
 match extcommunity {{ g.name }}-RT
exit
{% endif %}
route-map {{ g.name }}-EVPN-IN deny 100
exit
route-map {{ g.name }}-EVPN-OUT deny 100
exit
!
{% endfor %}
{% elif bgw_rt_filter_enabled | bool %}
{% if bgw_allowed_rts | length > 0 %}
route-map SPOKES-EVPN-IN permit 10
 match extcommunity FABRIC-RT
exit
!
{% endif %}
route-map SPOKES-EVPN-IN deny 100
exit
!
{% endif %}
router bgp {{ bgw_asn }}
 bgp router-id {{ bgw_loopback }}
 bgp cluster-id {{ bgw_loopback }}
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
{% for g in bgw_peer_groups %}
 neighbor {{ g.name }} peer-group
 neighbor {{ g.name }} remote-as {{ bgw_asn }}
 neighbor {{ g.name }} ebgp-multihop 32
{% if bgw_bgp_password | length > 0 %}
 neighbor {{ g.name }} password {{ bgw_bgp_password }}
{% endif %}
{% for r in g.ranges %}
 bgp listen range {{ r }} peer-group {{ g.name }}
{% endfor %}
{% endfor %}
 !
 address-family ipv4 unicast
{% for g in bgw_peer_groups %}
  neighbor {{ g.name }} activate
  neighbor {{ g.name }} route-reflector-client
{% endfor %}
 exit-address-family
 !
 address-family l2vpn evpn
{% for g in bgw_peer_groups %}
  neighbor {{ g.name }} activate
  neighbor {{ g.name }} route-reflector-client
  neighbor {{ g.name }} attribute-unchanged next-hop
{% if bgw_rt_policy_per_site | bool %}
  {# no soft-reconfiguration inbound: FRR 8.5 replays EVPN routes without their VNI label, hub nodes then install Type-5 routes with encap id 0 (seen 2026-10-08) #}
  neighbor {{ g.name }} route-map {{ g.name }}-EVPN-IN in
  neighbor {{ g.name }} route-map {{ g.name }}-EVPN-OUT out
{% elif bgw_rt_filter_enabled | bool %}
  neighbor {{ g.name }} route-map SPOKES-EVPN-IN in
{% endif %}
{% endfor %}
 exit-address-family
exit
!
