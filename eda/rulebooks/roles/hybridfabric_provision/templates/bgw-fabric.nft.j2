#!/usr/sbin/nft -f
flush ruleset
table inet fabric {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    meta l4proto { icmp, ipv6-icmp } accept
    tcp dport 22 accept
    iifname "eth0" tcp dport {{ bgw_wss_port }} accept
    iifname "eth0" udp sport 67 udp dport 68 accept
    iifname { "eth1", "wg0" } tcp dport 179 accept
    iifname { "eth1", "wg0" } udp dport { 67, 4789 } accept
    iifname "lo" udp dport {{ bgw_wg_listen_port }} accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    iifname "eth1" oifname "wg0" accept
    iifname "wg0" oifname "eth1" accept
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
