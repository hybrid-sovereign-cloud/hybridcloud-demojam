#cloud-config
# Fabric border gateway {{ bgw_name }} (HybridFabric {{ bgw_fabric_name }}).
# Rendered by EDA hybridfabric_provision; stored only in Secret {{ bgw_name }}-cloudinit.
hostname: {{ bgw_name }}
fqdn: {{ bgw_name }}
{% if bgw_ssh_public_key | length > 0 %}
users:
- name: cloud-user
  sudo: ALL=(ALL) NOPASSWD:ALL
  shell: /bin/bash
  lock_passwd: true
  ssh_authorized_keys:
  - {{ bgw_ssh_public_key }}
{% endif %}
ssh_pwauth: false
package_update: false
packages:
- frr
- wireguard-tools
- dnsmasq
- nftables
- tcpdump
- iproute
- bind-utils
- qemu-guest-agent
- python3
- tar
- curl
write_files:
{% if bgw_wg_enabled %}
- path: /etc/wireguard/wg0.conf
  permissions: '0600'
  owner: root:root
  content: |
    {{ bgw_wg0_conf | indent(4) }}
{% endif %}
- path: /etc/NetworkManager/system-connections/underlay.nmconnection
  permissions: '0600'
  owner: root:root
  content: |
    [connection]
    id=underlay
    type=ethernet
    interface-name=eth1
    autoconnect=true
    autoconnect-priority=100

    [ethernet]
    mac-address={{ bgw_underlay_mac | upper }}
    mtu={{ bgw_underlay_mtu }}

    [ipv4]
    method=manual
    address1={{ bgw_underlay_address }}/{{ bgw_underlay_prefixlen }}
    never-default=true
    may-fail=false

    [ipv6]
    method=disabled
- path: /etc/NetworkManager/conf.d/90-no-auto-default.conf
  permissions: '0644'
  content: |
    [main]
    no-auto-default=*
- path: /etc/sysctl.d/90-fabric.conf
  permissions: '0644'
  owner: root:root
  content: |
    net.ipv4.ip_forward = 1
    net.ipv4.conf.all.rp_filter = 2
    net.ipv4.conf.default.rp_filter = 2
- path: /etc/sysconfig/nftables.conf
  permissions: '0600'
  owner: root:root
  content: |
    {{ bgw_fabric_nft | indent(4) }}
- path: /etc/dnsmasq.d/fabric.conf
  permissions: '0644'
  owner: root:root
  content: |
    {{ bgw_dnsmasq_conf | indent(4) }}
- path: /root/frr.conf.fabric
  permissions: '0640'
  owner: root:root
  content: |
    {{ bgw_frr_conf | indent(4) }}
- path: /etc/systemd/system/fabric-lo.service
  permissions: '0644'
  content: |
    [Unit]
    Description=Fabric loopback {{ bgw_loopback }}/32
    After=network-pre.target
    Before=frr.service network-online.target
    Wants=network-pre.target

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/bin/sh -c 'ip addr show dev lo | grep -q {{ bgw_loopback }}/32 || ip addr add {{ bgw_loopback }}/32 dev lo'

    [Install]
    WantedBy=multi-user.target
- path: /etc/systemd/system/wstunnel.service
  permissions: '0644'
  owner: root:root
  content: |
    [Unit]
    Description=wstunnel server (WireGuard over WSS)
    After=network-online.target
    Wants=network-online.target

    [Service]
    ExecStart=/usr/local/bin/wstunnel server --restrict-to 127.0.0.1:{{ bgw_wg_listen_port }} wss://0.0.0.0:{{ bgw_wss_port }}
    Restart=always
    RestartSec=3
    DynamicUser=yes

    [Install]
    WantedBy=multi-user.target
- path: /etc/systemd/system/fabric-config-sync.service
  permissions: '0644'
  content: |
    [Unit]
    Description=Apply fabric BGW config from the config Secret disk
    After=local-fs.target systemd-udev-settle.service
    Before=nftables.service wg-quick@wg0.service frr.service dnsmasq.service

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/sbin/fabric-config-sync.sh

    [Install]
    WantedBy=multi-user.target
- path: /usr/local/sbin/install-wstunnel.sh
  permissions: '0755'
  owner: root:root
  content: |
    {{ lookup('file', role_path ~ '/files/install-wstunnel.sh') | indent(4) }}
- path: /usr/local/sbin/fabric-config-sync.sh
  permissions: '0755'
  owner: root:root
  content: |
    {{ lookup('file', role_path ~ '/files/fabric-config-sync.sh') | indent(4) }}
- path: /usr/local/sbin/fabric-bgw-setup.sh
  permissions: '0755'
  owner: root:root
  content: |
    {{ lookup('file', role_path ~ '/files/fabric-bgw-setup.sh') | indent(4) }}
runcmd:
- /usr/local/sbin/fabric-bgw-setup.sh
