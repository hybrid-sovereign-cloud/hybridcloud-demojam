---
# WireGuard-style hostNetwork sshd that accepts SSH TUN (-w) from a spoke.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ tl_ssh_deploy_name }}
  namespace: {{ tl_ssh_namespace }}
  labels:
    app: fabric-ssh-tunnel
    hybridsovereign.redhat/transportlink: "{{ transportlink_cr_name }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fabric-ssh-tunnel
      hybridsovereign.redhat/transportlink: "{{ transportlink_cr_name }}"
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: fabric-ssh-tunnel
        hybridsovereign.redhat/transportlink: "{{ transportlink_cr_name }}"
    spec:
      serviceAccountName: hub-rr
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector:
        kubernetes.io/hostname: "{{ tl_ssh_hub_node }}"
      containers:
        - name: sshd
          image: {{ tl_ssh_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
            runAsUser: 0
          env:
            - name: HUB_TUN
              value: "{{ tl_ssh_hub_tun }}"
            - name: SPOKE_TUN_IP
              value: "{{ tl_ssh_spoke_tun.split('/')[0] }}"
            - name: HUB_ROUTES
              value: "{{ tl_ssh_hub_routes }}"
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              dnf install -y openssh-server iproute iputils procps-ng 2>/dev/null | tail -3 || true
              mkdir -p /var/run/sshd /root/.ssh /dev/net
              [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200
              cp /cfg/sshd_config /etc/ssh/sshd_config
              cp /keys/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key
              cp /keys/authorized_keys /etc/ssh/authorized_keys
              cp /keys/authorized_keys /root/.ssh/authorized_keys
              chmod 600 /etc/ssh/ssh_host_ed25519_key /etc/ssh/authorized_keys /root/.ssh/authorized_keys
              chmod 700 /root/.ssh
              ssh-keygen -A
              # Background: when spoke creates tun0 via ssh -w, assign hub addr + routes.
              (
                while true; do
                  if ip link show tun0 >/dev/null 2>&1; then
                    ip addr replace "$HUB_TUN" dev tun0 || true
                    ip link set tun0 up || true
                    for cidr in $HUB_ROUTES; do
                      ip route replace "$cidr" via "$SPOKE_TUN_IP" dev tun0 || true
                    done
                  fi
                  sleep 10
                done
              ) &
              exec /usr/sbin/sshd -D -e
          volumeMounts:
            - name: cfg
              mountPath: /cfg
            - name: keys
              mountPath: /keys
              readOnly: true
      volumes:
        - name: cfg
          configMap:
            name: {{ tl_ssh_deploy_name }}-cfg
        - name: keys
          secret:
            secretName: {{ tl_ssh_deploy_name }}
            defaultMode: 0600
