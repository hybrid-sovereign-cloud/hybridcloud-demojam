apiVersion: nmstate.io/v1
kind: NodeNetworkConfigurationPolicy
metadata:
  name: "fabric-underlay-{{ cgw_nncp_node }}"
  labels:
    hybridsovereign.redhat/fabric-underlay: "true"
    hybridsovereign.redhat/cloudgateway: "{{ cloudgateway_cr_name }}"
spec:
  nodeSelector:
    kubernetes.io/hostname: "{{ cgw_nncp_node }}"
  desiredState:
    interfaces:
    - name: "{{ cgw_su_interface }}"
      type: ethernet
      state: up
      mtu: {{ cgw_su_mtu | int }}
      ipv4: {enabled: false}
      ipv6: {enabled: false}
    - name: "{{ cgw_su_bridge }}"
      description: Hybrid Sovereign fabric site underlay (EVPN VXLAN to EDPM {{ cgw_su_compute_interface }})
      type: linux-bridge
      state: up
      mtu: {{ cgw_su_mtu | int }}
      ipv4: {enabled: false}
      ipv6: {enabled: false}
      bridge:
        options:
          stp: {enabled: false}
        port:
        - name: "{{ cgw_su_interface }}"
