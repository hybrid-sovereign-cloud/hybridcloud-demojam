apiVersion: hypershift.openshift.io/v1beta1
kind: NodePool
metadata:
  name: "{{ hc_name }}-workers"
  namespace: "{{ hc_namespace }}"
spec:
  clusterName: "{{ hc_name }}"
  replicas: {{ hc_node_replicas | int }}
  management:
    autoRepair: false
    upgradeType: Replace
  platform:
    type: KubeVirt
    kubevirt:
      compute:
        cores: {{ hc_worker_cores | int }}
        memory: "{{ hc_worker_memory }}"
      rootVolume:
        size: "32Gi"
        type: Persistent
        persistent:
          size: "32Gi"
{% if (hc_additional_networks | default([])) | length > 0 %}
      # Fabric hub underlay (eth1, DHCP from the border gateway) — VTEP for EVPN.
      attachDefaultNetwork: true
      additionalNetworks:
{% for n in hc_additional_networks %}
        - name: "{{ n.name }}"
{% endfor %}
{% endif %}
  release:
    image: "{{ hc_release_image }}"
