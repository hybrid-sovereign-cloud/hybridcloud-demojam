---
# Per-spoke WireGuard agent — hostNetwork on HCP worker, routes VTEP CIDR via hub.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ tl_wg_namespace }}
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: fabric-wg
  namespace: {{ tl_wg_namespace }}
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
---
apiVersion: security.openshift.io/v1
kind: SecurityContextConstraints
metadata:
  name: fabric-wg-hostnetwork
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
allowHostDirVolumePlugin: false
allowHostIPC: false
allowHostNetwork: true
allowHostPID: false
allowHostPorts: true
allowPrivilegeEscalation: true
allowPrivilegedContainer: true
allowedCapabilities:
  - NET_ADMIN
  - NET_RAW
  - SYS_MODULE
defaultAddCapabilities: null
fsGroup:
  type: RunAsAny
groups: []
priority: 10
readOnlyRootFilesystem: false
requiredDropCapabilities:
  - MKNOD
runAsUser:
  type: RunAsAny
seLinuxContext:
  type: RunAsAny
supplementalGroups:
  type: RunAsAny
users:
  - "system:serviceaccount:{{ tl_wg_namespace }}:fabric-wg"
volumes:
  - configMap
  - secret
  - emptyDir
  - projected
  - downwardAPI
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: fabric-wg-scripts
  namespace: {{ tl_wg_namespace }}
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
data:
  wg-start.sh: |
{{ tl_wg_start_script | indent(4, first=True) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fabric-wg-{{ tl_wg_peer_name }}
  namespace: {{ tl_wg_namespace }}
  labels:
    app: fabric-wg-spoke
    hybridsovereign.redhat/fabric-wg: spoke
    hybridsovereign.redhat/wg-peer: "{{ tl_wg_peer_name }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fabric-wg-{{ tl_wg_peer_name }}
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: fabric-wg-{{ tl_wg_peer_name }}
        hybridsovereign.redhat/fabric-wg: spoke
        hybridsovereign.redhat/wg-peer: "{{ tl_wg_peer_name }}"
    spec:
      serviceAccountName: fabric-wg
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector:
        kubernetes.io/hostname: "{{ tl_wg_peer_node }}"
      containers:
        - name: wireguard
          image: {{ tl_wg_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
            runAsUser: 0
          env:
            - name: WG_ADDRESS
              value: "{{ tl_wg_peer_address }}"
            - name: WG_CONF
              value: /etc/wireguard/wg0.conf
            - name: WG_ROUTES
              value: "{{ tl_wg_spoke_routes }}"
            - name: WG_ROUTE_SRC
              value: "{{ tl_wg_spoke_route_src | default('') }}"
            - name: WG_ROUTE_INTERVAL
              value: "{{ tl_wg_route_interval | default('15') }}"
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              mkdir -p /binaries
              if [ -f /scripts/wg ]; then
                install -m 0755 /scripts/wg /binaries/wg
              fi
              export PATH=/binaries:$PATH
              bash /scripts/wg-start.sh
          volumeMounts:
            - name: wg-conf
              mountPath: /etc/wireguard
              readOnly: true
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: binaries
              mountPath: /binaries
          readinessProbe:
            exec:
              command: ["/binaries/wg", "show", "wg0"]
            initialDelaySeconds: 5
            periodSeconds: 10
      volumes:
        - name: wg-conf
          secret:
            secretName: fabric-wg-{{ tl_wg_peer_name }}
        - name: scripts
          configMap:
            name: fabric-wg-scripts
            defaultMode: 0755
        - name: binaries
          emptyDir: {}
