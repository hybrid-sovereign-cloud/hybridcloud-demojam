---
# Hub WireGuard gateway — hostNetwork on CENTRAL, peers = spoke VTEP /32s.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: fabric-wg
  namespace: {{ tl_wg_namespace }}
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
---
apiVersion: security.openshift.io/v1
kind: SecurityContextConstraints
metadata:
  name: fabric-wg-hostnetwork
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
allowHostDirVolumePlugin: false
allowHostIPC: false
allowHostNetwork: true
allowHostPID: false
allowHostPorts: true
allowPrivilegeEscalation: true
allowPrivilegedContainer: true
allowedCapabilities:
  - NET_ADMIN
  - NET_RAW
  - SYS_MODULE
defaultAddCapabilities: null
fsGroup:
  type: RunAsAny
groups: []
priority: 10
readOnlyRootFilesystem: false
requiredDropCapabilities:
  - MKNOD
runAsUser:
  type: RunAsAny
seLinuxContext:
  type: RunAsAny
supplementalGroups:
  type: RunAsAny
users:
  - "system:serviceaccount:{{ tl_wg_namespace }}:fabric-wg"
volumes:
  - configMap
  - secret
  - emptyDir
  - projected
  - downwardAPI
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: fabric-wg-scripts
  namespace: {{ tl_wg_namespace }}
  labels:
    hybridsovereign.redhat/fabric-wg: "true"
data:
  wg-start.sh: |
{{ tl_wg_start_script | indent(4, first=True) }}
binaryData:
  wg: {{ lookup('file', role_path ~ '/files/wg') | b64encode }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fabric-wg-hub
  namespace: {{ tl_wg_namespace }}
  labels:
    app: fabric-wg-hub
    hybridsovereign.redhat/fabric-wg: hub
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fabric-wg-hub
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: fabric-wg-hub
        hybridsovereign.redhat/fabric-wg: hub
    spec:
      serviceAccountName: fabric-wg
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
{% if tl_wg_hub_node | default('') | length > 0 %}
      nodeSelector:
        kubernetes.io/hostname: "{{ tl_wg_hub_node }}"
{% endif %}
      containers:
        - name: wireguard
          image: {{ tl_wg_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
            runAsUser: 0
          env:
            - name: WG_ADDRESS
              value: "{{ tl_wg_hub_address }}"
            - name: WG_CONF
              value: /etc/wireguard/wg0.conf
            - name: WG_ROUTES
              value: "{{ tl_wg_hub_routes }}"
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              mkdir -p /binaries
              if [ -f /scripts/wg ]; then
                install -m 0755 /scripts/wg /binaries/wg
              fi
              export PATH=/binaries:$PATH
              bash /scripts/wg-start.sh
          ports:
            - name: wg
              containerPort: {{ tl_wg_listen_port | int }}
              protocol: UDP
          volumeMounts:
            - name: wg-conf
              mountPath: /etc/wireguard
              readOnly: true
            - name: scripts
              mountPath: /scripts
              readOnly: true
            - name: binaries
              mountPath: /binaries
          readinessProbe:
            exec:
              command: ["/binaries/wg", "show", "wg0"]
            initialDelaySeconds: 5
            periodSeconds: 10
      volumes:
        - name: wg-conf
          secret:
            secretName: {{ tl_wg_hub_secret }}
        - name: scripts
          configMap:
            name: fabric-wg-scripts
            defaultMode: 0755
        - name: binaries
          emptyDir: {}
